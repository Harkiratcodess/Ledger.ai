# ==============================================================================
# AgentGuard Environment Configuration
# ==============================================================================

# Backend Server
PORT=5000
HOST=localhost

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/agentguard

# Proxy & Network Interception Configuration
AGENTGUARD_PROXY_HOST=host.docker.internal
AGENTGUARD_PROXY_PORT=8080

# Docker Sandbox Image & Container Settings
AGENTGUARD_SANDBOX_IMAGE=node:20-slim

# CLI Configuration (Optional Override for remote/custom backend URL)
# AGENTGUARD_API_URL=http://localhost:5000

# Autonomous LLM Planning (Optional / Dev Mode)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
AGENTGUARD_MAX_AGENT_ITERATIONS=10
