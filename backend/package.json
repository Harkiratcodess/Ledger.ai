{
  "name": "ledger-security",
  "version": "0.1.0",
  "description": "Ledger: local security runtime and MCP gateway for AI coding agents",
  "keywords": [
    "ledger",
    "security",
    "ai-agents",
    "mcp",
    "sandbox",
    "docker"
  ],
  "license": "MIT",
  "author": "Ledger Security",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harkiratcodess/Ledger.ai"
  },
  "main": "src/server.js",
  "bin": {
    "ledger": "./bin/agentguard.js",
    "agentguard": "./bin/agentguard.js",
    "ledger-mcp": "./bin/agentguard-mcp.js",
    "agentguard-mcp": "./bin/agentguard-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/__pycache__/**",
    "!src/**/*.pyc",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^9.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
